{
  "name": "codegraph-studio",
  "displayName": "Codegraph Studio",
  "version": "0.1.1",
  "icon": "media/icon.png",
  "private": true,
  "publisher": "stovberpv",
  "description": "%codegraph.description%",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": [
    "typescript",
    "call graph",
    "dependency graph",
    "code visualization",
    "architecture",
    "canvas",
    "ast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stovberpv/codegraph-studio.git"
  },
  "homepage": "https://github.com/stovberpv/codegraph-studio#readme",
  "bugs": {
    "url": "https://github.com/stovberpv/codegraph-studio/issues"
  },
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "codegraph.open",
        "title": "%codegraph.open.title%",
        "category": "%codegraph.category%"
      },
      {
        "command": "codegraph.rebuild",
        "title": "%codegraph.rebuild.title%",
        "category": "%codegraph.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "codegraph.rebuildFrom",
        "title": "%codegraph.rebuildFrom.title%",
        "category": "%codegraph.category%",
        "icon": "$(folder-opened)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codegraphStudio",
          "title": "%codegraph.category%",
          "icon": "media/codegraph.svg"
        }
      ]
    },
    "views": {
      "codegraphStudio": [
        {
          "id": "codegraph.launch",
          "name": "%codegraph.view.title%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "codegraph.rebuild" },
        { "command": "codegraph.rebuildFrom" }
      ],
      "editor/title": [
        { "command": "codegraph.rebuild", "when": "activeWebviewPanelId == 'codegraph'", "group": "navigation@1" },
        { "command": "codegraph.rebuildFrom", "when": "activeWebviewPanelId == 'codegraph'", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "%codegraph.category%",
      "properties": {
        "codegraph.debugParsePaths": {
          "type": "boolean",
          "default": false,
          "description": "%codegraph.config.debugParsePaths.description%"
        }
      }
    }
  },
  "bin": {
    "codegraph-studio": "src/core/parse.ts"
  },
  "scripts": {
    "parse": "tsx src/core/parse.ts",
    "serve": "tsx src/server/serve.ts",
    "graph": "npm run build && tsx src/core/parse.ts && tsx src/server/serve.ts",
    "build": "node scripts/esbuild.mjs",
    "build:prod": "node scripts/esbuild.mjs --minify",
    "watch": "node scripts/esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build:prod && vsce package --no-dependencies",
    "publish": "npm run build:prod && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "codemirror": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "pug": "^3.0.3",
    "tsx": "^4.20.3"
  }
}
